HOST=127.0.0.1
PORT=8000
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
BACKEND_URL=http://localhost:5000
AI_SERVICE_INTERNAL_SECRET=replace_with_shared_internal_secret

# Voice STT / TTS Configuration
ENABLE_VOICE_STT=true
ENABLE_VOICE_TTS=true
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_AUTO_DOWNLOAD=false
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_AUDIO_SECONDS=120
VOICE_MAX_TTS_CHARS=1500

# Optional Bhashini ULCA / Dhruva Cloud Provider (off by default)
ENABLE_BHASHINI=false
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=
